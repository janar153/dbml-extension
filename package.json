{
  "name": "dbml-extension",
  "displayName": "DBML Extension",
  "description": "Create and edit DBML database and architecture diagrams in VS Code. Share Git-friendly layouts and export PostgreSQL SQL, TypeORM, SVG, and PNG.",
  "version": "2.0.1",
  "publisher": "janar153",
  "icon": "docs/dbml-extension-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "dbml",
    "diagram",
    "erd",
    "database",
    "schema",
    "ddd"
  ],
  "main": "./dist/extension/extension/extension.js",
  "packageManager": "pnpm@12.21.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/janar153/dbml-extension"
  },
  "homepage": "https://github.com/janar153/dbml-extension#readme",
  "bugs": {
    "url": "https://github.com/janar153/dbml-extension/issues"
  },
  "contributes": {
    "commands": [
      {
        "command": "dbml-extension.openDiagram",
        "title": "Open Diagram",
        "category": "DBML Extension",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "dbml-extension.resetLayout",
        "title": "Reset Layout (re-run auto-layout)",
        "category": "DBML Extension"
      },
      {
        "command": "dbml-extension.pruneOrphans",
        "title": "Prune orphan layout entries",
        "category": "DBML Extension"
      },
      {
        "command": "dbml-extension.exportSchema",
        "title": "Export Schema…",
        "category": "DBML Extension"
      },
      {
        "command": "dbml-extension.exportImage",
        "title": "Export Image…",
        "category": "DBML Extension"
      },
      {
        "command": "dbml-extension.autoArrange",
        "title": "Auto-arrange Diagram…",
        "category": "DBML Extension"
      },
      {
        "command": "dbml-extension.zoomIn",
        "title": "Zoom In",
        "category": "DBML Extension"
      },
      {
        "command": "dbml-extension.zoomOut",
        "title": "Zoom Out",
        "category": "DBML Extension"
      },
      {
        "command": "dbml-extension.resetView",
        "title": "Reset View",
        "category": "DBML Extension"
      },
      {
        "command": "dbml-extension.fitToContent",
        "title": "Fit to Content",
        "category": "DBML Extension"
      }
    ],
    "keybindings": [
      {
        "command": "dbml-extension.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeWebviewPanelId == 'dbml-extension.diagram'"
      },
      {
        "command": "dbml-extension.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeWebviewPanelId == 'dbml-extension.diagram'"
      },
      {
        "command": "dbml-extension.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeWebviewPanelId == 'dbml-extension.diagram'"
      },
      {
        "command": "dbml-extension.resetView",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeWebviewPanelId == 'dbml-extension.diagram'"
      },
      {
        "command": "dbml-extension.fitToContent",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'dbml-extension.diagram'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .dbml",
          "command": "dbml-extension.openDiagram",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .dbml",
          "command": "dbml-extension.openDiagram",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "dbml",
        "extensions": [
          ".dbml"
        ],
        "aliases": [
          "DBML",
          "dbml",
          "Database Markup Language"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dbml",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dbml",
        "path": "./snippets/dbml.json"
      }
    ],
    "configuration": {
      "title": "DBML Extension",
      "properties": {
        "dbml-extension.zoomStep": {
          "type": "number",
          "default": 1.2,
          "minimum": 1.01,
          "maximum": 4,
          "description": "Multiplicative zoom factor applied per zoom-in / zoom-out click or keyboard shortcut."
        },
        "dbml-extension.zoomMin": {
          "type": "number",
          "default": 0.08,
          "minimum": 0.01,
          "maximum": 1,
          "description": "Minimum allowed zoom level (1 = 100%)."
        },
        "dbml-extension.zoomMax": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum allowed zoom level (1 = 100%)."
        },
        "dbml-extension.lod.lowThreshold": {
          "type": "number",
          "default": 0.3,
          "minimum": 0.01,
          "maximum": 1,
          "description": "Below this zoom level, tables render as colored rectangles (name shown on hover); at or above it, full columns render."
        },
        "dbml-extension.ui.density": {
          "type": "string",
          "default": "cozy",
          "enum": [
            "compact",
            "cozy",
            "comfortable"
          ],
          "enumDescriptions": [
            "Tight rows and narrow tables. Best for diagrams with 200+ tables.",
            "Default density. Balanced for typical DDD-sized diagrams.",
            "Roomy rows and wide tables. Best for small focused views."
          ],
          "description": "Visual density of tables and rows. Controls table width, row height, padding, and font size."
        },
        "dbml-extension.ui.diagramAppearance": {
          "type": "string",
          "default": "theme",
          "enum": ["theme", "print-light", "print-dark"],
          "description": "Use the VS Code theme or edit the printer-friendly diagram in a light or dark palette."
        },
        "dbml-extension.ui.showKeyColumn": {
          "type": "boolean",
          "default": false,
          "description": "Show a headerless PK/FK column before the field names on diagram tables."
        },
        "dbml-extension.ui.snapToGrid": {
          "type": "boolean",
          "default": false,
          "description": "Magnet mode: snap table positions and edge bend vertices to the grid, and show a dotted grid background."
        },
        "dbml-extension.ui.gridSize": {
          "type": "number",
          "default": 16,
          "minimum": 2,
          "maximum": 128,
          "description": "World-unit spacing of the snap grid used when magnet mode (ui.snapToGrid) is on."
        },
        "dbml-extension.ui.layoutSpacing": {
          "type": "number",
          "default": 1,
          "minimum": 0.4,
          "maximum": 2.5,
          "description": "Smart auto-layout density. Below 1 packs tables and groups tighter; above 1 spreads them out. Applied on the next auto-arrange."
        },
        "dbml-extension.export.defaultFormat": {
          "type": "string",
          "default": "typeorm",
          "description": "Format pre-selected in the Export modal. Must match a registered exporter id."
        },
        "dbml-extension.export.typeorm.dialect": {
          "type": "string",
          "default": "postgres",
          "enum": [
            "postgres"
          ],
          "description": "SQL dialect that drives DBML→TypeScript type mapping for the TypeORM exporter."
        },
        "dbml-extension.export.typeorm.singularize": {
          "type": "boolean",
          "default": true,
          "description": "Singularize class names using an English heuristic (e.g. order_items → OrderItem)."
        },
        "dbml-extension.export.typeorm.includeImports": {
          "type": "boolean",
          "default": true,
          "description": "Emit the typeorm import line at the top of the generated file."
        },
        "dbml-extension.export.typeorm.emitNullableExplicit": {
          "type": "boolean",
          "default": true,
          "description": "Also emit the redundant `nullable: false` on NOT NULL columns. `nullable: true` is always emitted when a column is nullable."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:dbml",
    "onCommand:dbml-extension.openDiagram",
    "onCommand:dbml-extension.exportSchema"
  ],
  "scripts": {
    "build:extension": "node -e \"require('fs').rmSync('dist/extension',{recursive:true,force:true})\" && esbuild src/extension/extension.ts src/extension/parseWorker.ts --bundle --outdir=dist/extension/extension --external:vscode --platform=node --format=cjs --minify --sourcemap",
    "build:webview": "vite build",
    "build": "pnpm run build:extension && pnpm run build:webview",
    "watch:extension": "esbuild src/extension/extension.ts src/extension/parseWorker.ts --bundle --outdir=dist/extension/extension --external:vscode --platform=node --format=cjs --sourcemap --watch",
    "watch:webview": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:gen": "mkdir -p test/fixtures && node scripts/gen-fixtures.mjs small > test/fixtures/small.dbml && node scripts/gen-fixtures.mjs huge > test/fixtures/huge.dbml && node scripts/gen-fixtures.mjs merge 3 && node scripts/gen-fixtures.mjs merge 20",
    "test": "vitest run",
    "test:perf": "vitest run --mode performance --no-file-parallelism dragFrame.perf astar.perf",
    "test:watch": "vitest",
    "package": "node scripts/package-extension.mjs",
    "vscode:prepublish": "pnpm run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@dbml/core": "^12.1.0",
    "@vscode/codicons": "^0.0.46-24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "preact": "^11.2.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
