    alates timestamp [not null]
    kuni timestamp [not null]
    kommentaar text

    indexes {
        (kasutaja_ID, kasutajanimi) [pk]
    }

    records {
        1, 'janarn', 1, 'hash_value_1', 'salt_value_1', '2024-01-01 00:00:00', '9999-12-31 23:59:59', NULL
    }
}

