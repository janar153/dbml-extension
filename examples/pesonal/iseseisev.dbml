Table ISIK {
    isik_ID bigint [pk, not null]
    eesnimi varchar(255)
    perenimi varchar(255)
    email varchar(255)
    alates timestamp [not null]
    kuni timestamp [not null]
    kommentaar text

    records {
        1, 'Janar', 'Nagel', 'janarn@taltech.ee', '2024-01-01 00:00:00', '9999-12-31 23:59:59', NULL
        2, 'Priit', 'Raspel', 'priit.raspel@taltech.ee', '2024-01-01 00:00:00', '9999-12-31 23:59:59', NULL
    }
}

Table OPPEJOUD {
    oppejoud_ID bigint [pk, not null]
    alates timestamp [not null]
    kuni timestamp [not null]
    kommentaar text
