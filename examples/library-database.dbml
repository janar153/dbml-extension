Project "Campus Library" {
  database_type: 'PostgreSQL'
  document_type: 'ERD schema'
  author: 'Campus Library team'
  font_size: '34'
  logo: 'library-mark.svg'
  Note: 'Catalogue, reader accounts, circulation, and reporting.'
}

TablePartial timestamps {
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Enum circulation.loan_status {
  open
  returned [note: 'The copy is back in the library']
  overdue
}

Table public.members [headercolor: #3D698A] {
  id int [pk, increment]
  email varchar(200) [not null, unique, note: 'Used for reminders']
  sponsor_id int [ref: > public.members.id]
  ~timestamps
  Note: 'A member can sponsor a new reader.'
}

Table public.member_profiles {
  member_id int [pk]
  display_name varchar(100) [not null]
}

Table catalog.books as B {
  id int [pk, increment]
  isbn varchar(13) [not null, unique]
  title varchar(200) [not null]
  page_count int [check: `page_count > 0`]
  ~timestamps

  indexes {
    title [name: 'books_by_title', note: 'Catalogue search']
  }
}

Table catalog.copies {
  book_id int [not null, ref: > B.id]
  copy_number int [not null]
  shelf varchar(20) [not null]

  indexes {
    (book_id, copy_number) [pk]
  }
}

Table catalog.subjects {
  id int [pk]
  name varchar(100) [not null, unique]
  records {
    1, 'Databases'
    2, 'Software architecture'
  }
}

Table circulation.loans {
  id int [pk, increment]
  member_id int [not null]
  book_id int [not null]
  copy_number int [not null]
  status circulation.loan_status [not null, default: 'open']
  borrowed_on date [not null]
  due_on date [not null]
  returned_on date

  checks {
    `due_on >= borrowed_on` [name: 'loan_due_after_checkout']
    `returned_on IS NULL OR returned_on >= borrowed_on` [name: 'loan_return_after_checkout']
  }
}

Table circulation.reservations {
  id int [pk, increment]
  member_id int
  book_id int [not null, ref: > B.id]
  ~timestamps
}

Table reporting.loan_totals {
  report_date date [pk]
  total_loans int [not null, default: 0]
}

// Short forms for one-to-many, one-to-one, and many-to-many.
Ref member_loans: public.members.id < circulation.loans.member_id [delete: restrict, update: cascade]
Ref member_profile: public.members.id - public.member_profiles.member_id [delete: cascade]
Ref book_subjects: B.id <> catalog.subjects.id

// Long form for a composite many-to-one foreign key.
Ref loan_copy {
  circulation.loans.(book_id, copy_number) > catalog.copies.(book_id, copy_number) [delete: no action, color: #3D698A]
}

// Optional ends and a proposed relationship.
Ref optional_reservation_member: circulation.reservations.member_id ?>? public.members.id [delete: set null]
Ref proposed_loan_subject: circulation.loans.id <> catalog.subjects.id [inactive]

Records catalog.books (id, isbn, title, page_count) {
  1, '9780000000002', 'Library Systems', 260
  2, '9780000000019', 'Designing Catalogues', 180
}

Dep checkout_reporting [color: #507C60, note: 'Nightly rollup'] {
  circulation.loans.id -> reporting.loan_totals.total_loans
}

TableGroup catalogue [color: #D0E4F2, note: 'Books, physical copies, and classification'] {
  catalog.books
  catalog.copies
  catalog.subjects
}

TableGroup circulation_workflow [color: #E4EED8] {
  circulation.loans
  circulation.reservations
}

Note reading_guide [font: 'Georgia', font_size: 18] {
  '''
  Campus Library
  Dashed inactive refs illustrate proposals. The reporting dependency tracks data lineage.
  '''
}

Metadata Table public.members {
  owner: 'Reader Services'
}

DiagramView circulation_focus {
  Tables { public.members }
  TableGroups {
    catalogue
    circulation_workflow
  }
  Schemas { reporting }
  Notes { reading_guide }
}
